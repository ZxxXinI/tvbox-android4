<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- ===== 外观 ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="外观" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settings_theme"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/settings_font"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp" />
        </LinearLayout>

        <!-- ===== 视频源 ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="视频源" />

        <TextView
            android:id="@+id/settings_api"
            style="@style/Widget.Tv.NavButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="left|center_vertical"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settings_api_add"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="添加自定义源" />

            <TextView
                android:id="@+id/settings_api_manage"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="管理自定义源" />

            <TextView
                android:id="@+id/settings_api_qr"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="扫码添加接口" />
        </LinearLayout>

        <!-- ===== AI 推荐 ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="AI 推荐" />

        <TextView
            android:id="@+id/settings_ai_provider"
            style="@style/Widget.Tv.NavButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="left|center_vertical"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settings_ai_model"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/settings_ai_key"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_ai_qr"
            style="@style/Widget.Tv.NavButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="扫码配置 AI" />

        <!-- ===== 播放管家 ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="播放管家" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settings_auto_line"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/settings_stats"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="线路统计" />

            <TextView
                android:id="@+id/settings_stats_clear"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="清空统计" />
        </LinearLayout>

        <!-- ===== 版本更新 ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="版本更新" />

        <TextView
            android:id="@+id/settings_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settings_check_toggle"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/settings_update_action"
                style="@style/Widget.Tv.NavButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="检查更新" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/settings_ota_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settings_ota_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/settings_extension_services"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- ===== 扩展服务（暂时隐藏）===== -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="扩展服务" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/settings_iptv"
                    style="@style/Widget.Tv.NavButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="left|center_vertical"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/settings_iptv_test"
                    style="@style/Widget.Tv.NavButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:text="测试" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/settings_platform"
                    style="@style/Widget.Tv.NavButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="left|center_vertical"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/settings_platform_test"
                    style="@style/Widget.Tv.NavButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:text="测试" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
